# Local PostgreSQL (the compose file starts the database, not the application)
DATABASE_URL=postgresql://testpilot:testpilot@localhost:5432/testpilot
# Optional: without this, the investigator uses evidence-driven deterministic reasoning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Hard caps for token, DB query, and log exposure
LOG_EXCERPT_CHARS=12000
SIMILARITY_CANDIDATES=400
MAX_TOOL_ROUNDS=3
